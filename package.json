{
  "name": "opening-intel-api",
  "version": "0.1.0",
  "description": "MVP API for commercial opening asset intelligence platform",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "node scripts/migrate.js",
    "seed:demo": "node scripts/seed-demo.js",
    "orchestrator:dry-run": "tsx src/orchestrator/cli.ts",
    "orchestrator:ingest": "tsx src/orchestrator/ingestCli.ts",
    "orchestrator:discover": "tsx src/orchestrator/unattendedDiscoverCli.ts",
    "orchestrator:prepare-prompt": "tsx src/orchestrator/prepareUnattendedPromptCli.ts",
    "orchestrator:validate-diff": "tsx src/orchestrator/validateLaneDiffCli.ts",
    "orchestrator:image-generate": "tsx src/orchestrator/imageCandidateCli.ts",
    "orchestrator:image-qa": "tsx src/orchestrator/imageQaCli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pdfkit": "^0.19.1",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.15",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.12.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.8",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
