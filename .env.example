DATABASE_URL=postgres://user:password@localhost:5432/opening_intel
PORT=3000
JWT_SECRET=replace-with-a-long-random-string

# OI password recovery (separate from Netlify team login). Leave unset until
# a verified sender and the public nonproduction Dashboard origin are ready.
# Reset request returns 503 when any setting is missing; it never pretends to
# have sent a message. Configure as private server-side Netlify environment vars.
# RESEND_API_KEY=server-side-secret
# PASSWORD_RESET_FROM_EMAIL=Opening Intelligence <reset@verified.example.com>
# PASSWORD_RESET_PUBLIC_URL=https://your-protected-staging-domain.netlify.app/

# Comma-separated list of exact origins allowed to call this API (your deployed
# dashboard and field-app URLs). Required for a cloud deployment — the field
# app and dashboard will be on different domains than the API, so without this
# every request from them gets blocked by the browser's CORS check. Left unset,
# the API accepts requests from anywhere, which is fine for local dev only.
CORS_ORIGINS=https://dashboard.yourdomain.com,https://field.yourdomain.com

# Photo storage — works with real AWS S3, or any S3-compatible endpoint
# (Supabase Storage, Cloudflare R2, MinIO for local dev) by setting S3_ENDPOINT.
# Leave S3_ENDPOINT unset to use real AWS S3.
# NOTE: these are placeholders — put REAL keys only in your local .env (which is
# git-ignored), never in this committed template.
S3_BUCKET=opening-intel-photos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-s3-or-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-or-r2-secret-access-key
# S3_ENDPOINT=https://your-project.supabase.co/storage/v1/s3
# S3_PUBLIC_BASE_URL=https://cdn.yourdomain.com
