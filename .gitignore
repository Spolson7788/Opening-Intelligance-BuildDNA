# ---------------------------------------------------------------------------
# Opening Intel — root .gitignore (monorepo: API + dashboard + field-app)
# ---------------------------------------------------------------------------

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
build/

# Environment / secrets — NEVER commit these; they hold live credentials
# (database password, JWT secret, storage keys).
# NOTE: .env.example IS committed on purpose as a safe placeholder template;
# the real .env (and any *.local) is not.
.env
.env.local
.env.*.local
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS junk
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
