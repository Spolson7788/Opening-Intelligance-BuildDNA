+// Staging write gate: #save/#photos stay disabled until guard.js signals ready
+// AFTER successful init (window.__OI_STAGING_GUARD__.status==='ok'). Script onload is NOT success.
+function stagingGuardAllowsWrites(){
+  const g=window.__OI_STAGING_GUARD__;
+  return !!(g&&g.ready===true&&g.status==='ok');
+}
+function applyWriteControlsFromGuard(){
+  const allow=stagingGuardAllowsWrites();
+  const save=$('save'), photos=$('photos');
+  if(save){save.disabled=!allow; if(allow) save.removeAttribute('title'); else save.title='Blocked until staging guard is ready';}
+  if(photos){photos.disabled=!allow; if(allow) photos.removeAttribute('title'); else photos.title='Blocked until staging guard is ready';}
+}
+window.addEventListener('oi-staging-guard-ready',applyWriteControlsFromGuard);
+window.addEventListener('oi-staging-guard-fail',applyWriteControlsFromGuard);
+applyWriteControlsFromGuard();
